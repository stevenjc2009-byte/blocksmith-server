[Unit]
Description=Blocksmith authoritative game-logic process
Documentation=file:/opt/bsgate/README.md
# bsgame speaks to bsgate purely over /run/bsgate/{gate,game}.sock. That
# directory is bsgate.service's own RuntimeDirectory — it does not exist
# until bsgate.service creates it — so bsgame must never start before it,
# and has nothing useful to do once bsgate is gone. After= orders the
# start; BindsTo= is the stronger half: it also stops/restarts bsgame
# whenever bsgate.service stops, fails, or restarts, instead of leaving a
# game process alive and sending into sockets nobody is listening on.
After=bsgate.service
BindsTo=bsgate.service
# No network target here at all, unlike bsgate.service — this process never
# touches a network socket, only the two local Unix datagram sockets above,
# so it has no reason to wait on network-online.target.

[Service]
Type=simple

# A dedicated unprivileged account. Primary group bsgame (owns this
# process's own state directory below); supplementary group bsgate, which
# is what actually grants access to /run/bsgate and its socket files.
#
# That second part is deliberate, not a guess: bsgate.service runs as
# User=bsgate/Group=bsgate, so its RuntimeDirectory (/run/bsgate) is owned
# bsgate:bsgate at 0750, and the sockets it binds inside are 0770
# group-bsgate — see gateway/bsgate.c's umask(0007) around its bind() calls,
# which is what overrides the process-wide UMask=0077 for just those two
# files. Membership of `bsgate` is therefore the real permission boundary,
# and it is the one this unit is written against.
User=bsgame
Group=bsgame
SupplementaryGroups=bsgate

# /var/lib/bsgame, created 0700 and owned bsgame:bsgame. Holds
# block_diffs.bin — the authoritative log of every player-made block edit
# (game/diffstore.h). Never the same directory as /var/lib/bsgate (bsgate's
# own identity/allowlist state) — an update must leave both alone, and
# keeping them physically separate is what makes that easy to get right.
StateDirectory=bsgame
StateDirectoryMode=0700

# No RuntimeDirectory= here: the sockets this process binds/sends to live
# under bsgate's /run/bsgate, owned and created by bsgate.service, not this
# unit. Creating a second one would just be an unused empty directory.
ExecStart=/opt/bsgate/bsgame \
    --game-socket /run/bsgate/game.sock \
    --gate-socket /run/bsgate/gate.sock \
    --state-dir /var/lib/bsgame

Restart=on-failure
RestartSec=2s

# ---- sandbox ------------------------------------------------------------
# Same posture as bsgate.service, and for the same reason: this process
# accepts bytes that already passed bsgate's authentication, but
# "authenticated" is not "trusted" — a compromised or merely buggy client
# is explicitly in scope (see game/bsgame.c's header comment), so it is
# locked down to roughly nothing: no capabilities, no new privileges, a
# read-only filesystem, no devices, no kernel surface.

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077

# bsgame needs NO network access at all — it never opens an IP socket, only
# the two AF_UNIX datagram sockets above. PrivateNetwork=yes is the wrong
# tool for that: it puts the unit in its own network namespace, which is
# an orthogonal control (it hides network *interfaces*, not address
# families) and, like PrivateUsers below, wants namespace nesting this
# unprivileged LXC does not have. RestrictAddressFamilies= is the right
# tool: it is a seccomp filter on socket(2)'s address-family argument, so
# it can permit AF_UNIX and refuse every IP family outright with no
# namespace involved at all.
RestrictAddressFamilies=AF_UNIX

SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @debug @cpu-emulation @swap

# NOTE: PrivateUsers is deliberately NOT set, for the same reason as
# bsgate.service — it needs a nested user namespace, which requires
# `features: nesting=1` on the LXC, a strictly larger container attack
# surface than the one setting buys back. Everything above works in an
# unprivileged container without nesting.

# Bounded so a leak or a flood on the game-logic side cannot take the host
# down with it. This process holds one bounded in-memory diff table plus a
# small fixed-size player table — 128M is generous headroom, not a tight fit,
# same ceiling as bsgate for the same reason.
#
# The diff table is one instance of game/diffstore.h's BsDiffStore:
#   entry[BS_DIFF_MAX]    131072 x sizeof(BsDiff)  = 131072 x 16 = 2.000 MiB
#   table[BS_DIFF_SLOTS]  262144 x sizeof(int32_t) = 262144 x  4 = 1.000 MiB
#   sizeof(BsDiffStore)                            = 3146248 B   = 3.0005 MiB
# Each figure names the struct it came from on purpose, so the next drift is
# traceable to something re-derivable instead of to a number nobody can check.
# Measured, not estimated: compiled against game/diffstore.h with this repo's
# own CFLAGS and printed with sizeof on x86-64 Linux (gcc 15.2.0), 2026-08-25.
#
# Cross-checked against server commit b95f980 (2026-08-21), the commit that
# raised BS_DIFF_MAX 65536 -> 131072, which records "2 MiB of entries plus 1 MiB
# of index, measured in the linked binary as bss 3181512 bytes". Two independent
# routes to the same 2 + 1. The 3181512 there is whole-binary bss and so is
# larger than the 3146248 above, which is this one struct alone; the ~35 KiB
# difference is the other statics in the image, not a disagreement.
#
# This used to read "BS_DIFF_MAX = 65536 entries, ~1.5 MiB live + ~512 KiB
# index", and it was wrong in a more interesting way than simple staleness: it
# is a mixture of two eras that reconciles against no single value. The count
# was left at the pre-b95f980 65536, so an admin sizing a container off this
# line planned for half the entries the process actually allocates. The
# "~512 KiB index" was CORRECT, but for the old BS_DIFF_SLOTS of 131072. And
# "~1.5 MiB live" matched neither era — 65536 x 16 is 1.000 MiB, not 1.5; it
# looks like live+index summed and then double-counted. Doubling those figures
# would therefore have produced a wrong answer twice over, which is why they are
# recomputed here from the real sizeof rather than scaled.
#
# BS_DIFF_MAX itself is deliberately NOT changed by this edit, and the client's
# source/net/blockdiff.h declaring 65536 against this repo's 131072 is DELIBERATE
# DESIGN, not drift: what capped BS_DIFF_MAX was never memory here, it was memory
# on a 3DS, because the client's inbox had to match the server's store — and once
# per-column diff subscription landed the console holds edits for loaded columns
# only, so the two ceilings correctly came apart. Do not "fix" them into
# agreement. The client's check-diffcap-drift guard (client commit 6ff0b0f) takes
# the same stance: it asserts the client's recorded copy of the server's value
# still matches this repo's on-disk value, and pointedly does not assert that the
# two caps are equal.
MemoryMax=128M
TasksMax=16
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
