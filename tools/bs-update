#!/usr/bin/env bash
# bs-update — self-update the Blocksmith gateway+game install from GitHub.
#
# Installed as /usr/local/bin/update (see install/container-provision.sh),
# so `pct enter <ctid>` and typing `update` is the whole workflow — the same
# shape as the Proxmox community helper-scripts' `update` command.
#
#   update              check GitHub, and if a newer release is available,
#                        build it, run BOTH test suites, and only then
#                        install it.
#   update --check      report what is available; changes nothing.
#   update --version    print the installed version and exit.
#
# NEVER touched by an update — this is what "the server survives an update"
# means in practice:
#   /var/lib/bsgate          server identity keys, the friend allowlist
#   /var/lib/bsgame          world block diffs (game/diffstore.h)
#   /etc/playit/playit.toml  the playit secret
# None of those paths appear anywhere below. If that ever needs to change,
# it is a decision, not a refactor.
#
# Safety model:
#  - REPO_URL below is the ONLY remote this script will ever fetch from. If
#    /opt/bsgate/src already has a different `origin`, update refuses to
#    touch it (see check_origin). Without that check this file would be a
#    remote-code-execution primitive running as root: whoever controls
#    `origin` would control what gets built and installed here.
#  - A failed build or failed test suite is a no-op. Nothing under /opt is
#    touched until the new revision has built AND both test suites AND both
#    install-check targets have passed.
#  - The previously-installed binaries are kept as *.prev during the swap;
#    if either service fails to come back up afterwards, they are restored
#    and restarted automatically, and the script exits non-zero.

set -euo pipefail

# The one and only remote this script will ever pull from. Hardcoded on
# purpose — see the safety-model note above.
REPO_URL="https://github.com/stevenjc2009-byte/blocksmith-server.git"

INSTALL_ROOT="/opt/bsgate"
SRC_DIR="${INSTALL_ROOT}/src"
VERSION_FILE="${INSTALL_ROOT}/VERSION"
UNIT_DIR="/etc/systemd/system"

say()  { printf '  \033[1;36m->\033[0m %s\n' "$*"; }
warn() { printf '  \033[1;33m/!\033[0m %s\n' "$*" >&2; }
die()  { printf '  \033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }

# --------------------------------------------------------- PATH for root

# `pct enter <ctid>` gives an interactive NON-login shell, which never reads
# /etc/profile — so PATH is the bare init default and /usr/local is not on it.
# Measured on CT 105: PATH=/sbin:/bin:/usr/sbin:/usr/bin. Everything this
# project installs goes into /usr/local/bin or /usr/local/sbin, and both the
# README and the join guide tell him to type the bare command, so `update` and
# `bsgate-status` both answered "command not found" while sitting installed and
# executable a directory away.
#
# /root/.bashrc IS read by that shell, so it is the one file that fixes it.
# Idempotent twice over: the marker stops the block being appended again, and
# the case guard stops the PATH growing if something else already added it.
ensure_root_path() {
    local rc=/root/.bashrc
    local marker='# bsgate: put /usr/local on PATH for `pct enter` shells'

    [[ -f $rc ]] || touch "$rc"
    if grep -qF "$marker" "$rc" 2>/dev/null; then
        return 0
    fi

    printf '\n%s\n%s\n' "$marker" \
        'case ":$PATH:" in *:/usr/local/sbin:*) ;; *) PATH=/usr/local/sbin:/usr/local/bin:$PATH ;; esac' \
        >> "$rc"
    say "added /usr/local/{sbin,bin} to root's PATH in ${rc} (takes effect on your next 'pct enter')"
}

# ------------------------------------------------------------------ root

[[ ${EUID:-$(id -u)} -eq 0 ]] || die "update must run as root (it installs system binaries and unit files)"

# ------------------------------------------------------------------ mode

MODE="apply"
case "${1:-}" in
    --check)   MODE="check" ;;
    --version) MODE="version" ;;
    "")        MODE="apply" ;;
    -h|--help)
        cat <<EOF
usage: update [--check|--version]

  update            check GitHub and apply a newer release if one exists
  update --check    report what is available; change nothing
  update --version  print the installed version and exit
EOF
        exit 0
        ;;
    *) die "unknown option: $1 (usage: update [--check|--version])" ;;
esac

installed_version() {
    if [[ -f $VERSION_FILE ]]; then
        head -n1 "$VERSION_FILE" | tr -d '[:space:]'
    else
        echo "unknown"
    fi
}

CURRENT_VERSION=$(installed_version)

if [[ $MODE == version ]]; then
    echo "$CURRENT_VERSION"
    exit 0
fi

command -v git >/dev/null 2>&1 || die "git is not installed"

# ------------------------------------------------------------ origin pin

# Aborts loudly if $1 is a git checkout whose origin does not match
# REPO_URL. This is the difference between an updater and a remote code
# execution primitive: everything below this point assumes the checkout
# only ever tracks the pinned repo, and this is the one place that is
# actually enforced rather than assumed.
check_origin() {
    local dir=$1 origin
    origin=$(git -C "$dir" remote get-url origin 2>/dev/null) || return 0
    if [[ $origin != "$REPO_URL" ]]; then
        die "refusing to update: ${dir}'s 'origin' remote is '${origin}', not the pinned '${REPO_URL}'. Something repointed this checkout — leaving it untouched. Fix the remote by hand (or re-provision) before running update again."
    fi
}

# ------------------------------------------------------ tarball -> clone

# /opt/bsgate/src arrives as an extracted tarball (proxmox-lxc-install.sh
# pushes it and untars it) with no .git metadata at all. `git init` over
# that tree and trying to reconcile it against the real history is how you
# end up with a "repo" whose commit graph does not match what is actually
# on GitHub. Converting it is therefore a clone-fresh-and-swap, exactly
# like every later update, not a repair of what is already there.
ensure_git_checkout() {
    if [[ -d ${SRC_DIR}/.git ]]; then
        check_origin "$SRC_DIR"
        return 0
    fi

    [[ -d $SRC_DIR ]] || die "no source tree at ${SRC_DIR} to convert into a checkout"
    say "no git metadata under ${SRC_DIR} yet (still the pushed tarball) — cloning a real checkout of ${REPO_URL}"

    local tmp
    tmp=$(mktemp -d "${INSTALL_ROOT}/.src-clone.XXXXXX")
    if ! git clone -q "$REPO_URL" "$tmp" >/dev/null 2>&1; then
        rm -rf "$tmp"
        die "clone of ${REPO_URL} failed"
    fi

    # Best effort: if the currently-running version happens to match a real
    # tag in the freshly cloned history, start the checkout there instead of
    # at the clone's default branch tip. Either way the compare-and-update
    # logic below runs next and decides whether anything actually changes.
    if [[ $CURRENT_VERSION != unknown ]] \
        && git -C "$tmp" rev-parse -q --verify "refs/tags/v${CURRENT_VERSION}" >/dev/null; then
        git -C "$tmp" -c advice.detachedHead=false checkout -q "v${CURRENT_VERSION}"
    fi

    local backup
    backup="${SRC_DIR}.tarball.$(date +%Y%m%d%H%M%S)"
    mv "$SRC_DIR" "$backup"
    mv "$tmp" "$SRC_DIR"
    say "converted ${SRC_DIR} into a git checkout (the original tarball tree is kept at ${backup} — safe to delete once you've confirmed the update works)"
}

ensure_git_checkout

# ------------------------------------------------------------ find target

say "installed version: v${CURRENT_VERSION}"
say "fetching tags from origin"

# --force matters. Without it git refuses to move a tag that already exists
# locally and exits 1 ("would clobber existing tag"). That happened for real:
# the v1.0.3 tag was corrected and force-pushed on 2026-08-19, and from then on
# every already-deployed container's updater died on its next run — fixing a
# tag upstream permanently bricked the updater downstream. The clone under
# /opt/bsgate/src is a disposable build tree, not a record of anything, so
# taking whatever origin currently says a tag points at is always right here.
#
# The output is captured instead of --quiet'd so a failure can be shown at all.
# This script runs under `set -euo pipefail`, so before this the failing fetch
# killed it with NO message whatsoever: it printed the line above and returned
# to the prompt, looking exactly like "there is no update". It took `bash -x`
# on the real box to find it. A fetch that fails must say so.
FETCH_LOG=$(mktemp "${TMPDIR:-/tmp}/bs-update-fetch.XXXXXX.log")
if ! git -C "$SRC_DIR" fetch --tags --force --prune origin >"$FETCH_LOG" 2>&1; then
    warn "git fetch from ${REPO_URL} failed — nothing on this box was changed."
    cat "$FETCH_LOG" >&2
    rm -f "$FETCH_LOG"
    die "could not fetch from origin. Check DNS and outbound reachability, then retry by hand: git -C ${SRC_DIR} fetch --tags --force --prune origin"
fi
rm -f "$FETCH_LOG"

# Prefer the newest semver release tag over branch HEAD; fall back to the
# default branch only when there are no tags at all yet. `sort -V` is
# GNU coreutils version-sort, which orders v1.2.0 < v1.10.0 correctly
# (a plain lexical sort would not).
NEWEST_TAG=$(git -C "$SRC_DIR" tag -l | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)

if [[ -n $NEWEST_TAG ]]; then
    TARGET_REF="refs/tags/${NEWEST_TAG}"
    TARGET_VERSION="${NEWEST_TAG#v}"
    TARGET_DESC="v${TARGET_VERSION}"
else
    DEFAULT_BRANCH=$(git -C "$SRC_DIR" remote show origin 2>/dev/null | awk '/HEAD branch/ {print $NF}')
    [[ -n $DEFAULT_BRANCH ]] || die "no release tags exist on ${REPO_URL} and the default branch could not be determined"
    TARGET_REF="refs/remotes/origin/${DEFAULT_BRANCH}"
    TARGET_VERSION="${DEFAULT_BRANCH}@$(git -C "$SRC_DIR" rev-parse --short "$TARGET_REF")"
    TARGET_DESC="${TARGET_VERSION} (no release tags yet — using the default branch)"
fi

if [[ $TARGET_VERSION == "$CURRENT_VERSION" ]]; then
    say "Already up to date (v${CURRENT_VERSION})"
    exit 0
fi

say "update available: v${CURRENT_VERSION} -> ${TARGET_DESC}"

if [[ $MODE == check ]]; then
    exit 0
fi

# --------------------------------------------------------------- build

PREV_COMMIT=$(git -C "$SRC_DIR" rev-parse HEAD)

# Discard local modifications before switching. proxmox-lxc-install.sh pushes
# the source as a tarball and untars it OVER /opt/bsgate/src, so re-provisioning
# a container that has already been converted to a git checkout leaves the tree
# dirty, and git then refuses to switch:
#     error: Your local changes to the following files would be overwritten
# Measured on CT 105 on 2026-08-19: 5 files, 61 insertions, 14 deletions, every
# one of them just an older copy of a tracked file. ensure_git_checkout() above
# handles a bare tarball; this handles a tarball dropped over a clone.
#
# Safe because this tree holds nothing: all state lives in /var/lib/bsgate,
# /var/lib/bsgame and /etc/playit (see the header), and the very next line
# detach-checks-out over it anyway. Printed rather than done silently, because
# on the day someone IS hand-editing /opt/bsgate/src this is the message that
# tells them where their work went.
if ! git -C "$SRC_DIR" diff --quiet HEAD --; then
    warn "${SRC_DIR} has local modifications — discarding them before switching."
    warn "(this is normally just a re-provision untarring over the checkout)"
    git -C "$SRC_DIR" --no-pager diff --stat HEAD -- >&2
    git -C "$SRC_DIR" reset --hard --quiet HEAD
fi

say "checking out ${TARGET_DESC} (${TARGET_REF})"
git -C "$SRC_DIR" -c advice.detachedHead=false checkout -q --detach "$TARGET_REF"

BUILD_LOG=$(mktemp "${TMPDIR:-/tmp}/bs-update-build.XXXXXX.log")
trap 'rm -f "$BUILD_LOG"' EXIT

# Leaves the running install completely untouched: everything from here to
# the "tests passed" line below only ever writes into $SRC_DIR (the build
# tree) and $BUILD_LOG. Nothing under /opt/bsgate/bsgate, /opt/bsgate/bsgame
# or /etc/systemd/system is touched until every one of these six steps has
# passed.
run_step() {
    local desc=$1; shift
    say "$desc"
    "$@" >>"$BUILD_LOG" 2>&1
}

abort_build() {
    warn "update aborted — the currently running install was NOT touched."
    warn "last 60 lines of the build/test log (full log was ${BUILD_LOG}):"
    tail -60 "$BUILD_LOG" >&2
    # Put the checkout back where it was so a stuck build/test failure does
    # not leave /opt/bsgate/src sitting on a revision that does not match
    # what is actually installed and running.
    git -C "$SRC_DIR" checkout -q --detach "$PREV_COMMIT" 2>/dev/null || true
    exit 1
}

make -C "${SRC_DIR}/gateway" clean >>"$BUILD_LOG" 2>&1 || true
make -C "${SRC_DIR}/game"    clean >>"$BUILD_LOG" 2>&1 || true

run_step "building gateway"                  make -C "${SRC_DIR}/gateway" || abort_build
run_step "running gateway test suite"        make -C "${SRC_DIR}/gateway" test || abort_build
run_step "checking gateway binary hardening" make -C "${SRC_DIR}/gateway" install-check || abort_build

run_step "building game server"              make -C "${SRC_DIR}/game" || abort_build
run_step "running game test suite"           make -C "${SRC_DIR}/game" test || abort_build
run_step "checking game binary hardening"    make -C "${SRC_DIR}/game" install-check || abort_build

say "$(grep -oE '(PASS|FAIL) [0-9]+ checks.*' "$BUILD_LOG" | tail -2)"
say "both builds and both test suites passed — installing"

# --------------------------------------------------------------- install

# Keep a copy of everything the rollback below has to be able to undo. The unit
# files are in here for a reason: a release can perfectly well ship a good
# binary and a bad unit (a typo in ExecStart, a hardening directive the kernel
# on this box rejects), and the service then fails to come up for a reason that
# rolling back only the binaries cannot fix. Restoring one half and leaving the
# other is worse than either — it produces a running system in a state that was
# never tested.
for bin in bsgate bsgame; do
    if [[ -f ${INSTALL_ROOT}/${bin} ]]; then
        mv -f "${INSTALL_ROOT}/${bin}" "${INSTALL_ROOT}/${bin}.prev"
    fi
done

# Unit backups live under INSTALL_ROOT, not beside the units: systemd scans
# UNIT_DIR, and dropping unfamiliar files in there is a good way to earn a
# confusing warning from daemon-reload for no benefit.
for unit in bsgate.service bsgame.service; do
    if [[ -f ${UNIT_DIR}/${unit} ]]; then
        cp -a "${UNIT_DIR}/${unit}" "${INSTALL_ROOT}/${unit}.prev"
    fi
done

install -D -m 0755 -o root -g root "${SRC_DIR}/gateway/bsgate"         "${INSTALL_ROOT}/bsgate"
install -D -m 0755 -o root -g root "${SRC_DIR}/game/bsgame"            "${INSTALL_ROOT}/bsgame"

# Every admin tool in tools/, rather than a hardcoded list. The hardcoded list
# is exactly how bsgate-status shipped in v1.0.7 and then never appeared on the
# box that updated to v1.0.7 — `bsgate-status: command not found`, with the file
# sitting right there in ${SRC_DIR}/tools. A release can add a tool; this loop
# is what makes that tool reach a container that is already deployed.
#
# bs-update is the exception, and only in HOW it is written, not whether: it is
# the script currently executing, and `install` truncates its target in place,
# which corrupts a running bash script mid-read (bash reads the file lazily).
# Writing beside it and renaming is atomic — the running process keeps its own
# now-unlinked inode, and the next run picks up the new file.
for tool in "${SRC_DIR}"/tools/*; do
    [[ -f $tool ]] || continue
    tool_name=$(basename "$tool")
    if [[ $tool_name == bs-update ]]; then
        install -m 0755 -o root -g root "$tool" /usr/local/bin/.update.new
        mv -f /usr/local/bin/.update.new /usr/local/bin/update
    else
        install -D -m 0755 -o root -g root "$tool" "/usr/local/sbin/${tool_name}"
    fi
done

install -D -m 0644 -o root -g root "${SRC_DIR}/systemd/bsgate.service" "${UNIT_DIR}/bsgate.service"
install -D -m 0644 -o root -g root "${SRC_DIR}/systemd/bsgame.service" "${UNIT_DIR}/bsgame.service"
install -D -m 0644 -o root -g root "${SRC_DIR}/README.md"              "${INSTALL_ROOT}/README.md"

ensure_root_path

echo "$TARGET_VERSION" > "$VERSION_FILE"

systemctl daemon-reload
systemctl restart bsgate
systemctl restart bsgame

sleep 2
FAILED=0
systemctl is-active --quiet bsgate || FAILED=1
systemctl is-active --quiet bsgame || FAILED=1

if [[ $FAILED -eq 1 ]]; then
    warn "a service did not come back up after the update — rolling back"
    journalctl -u bsgate -u bsgame -n 40 --no-pager >&2 || true

    for bin in bsgate bsgame; do
        if [[ -f ${INSTALL_ROOT}/${bin}.prev ]]; then
            mv -f "${INSTALL_ROOT}/${bin}.prev" "${INSTALL_ROOT}/${bin}"
        fi
    done

    # Units too, or a release whose unit file is what broke the start would be
    # left permanently broken by a rollback that "succeeded".
    for unit in bsgate.service bsgame.service; do
        if [[ -f ${INSTALL_ROOT}/${unit}.prev ]]; then
            mv -f "${INSTALL_ROOT}/${unit}.prev" "${UNIT_DIR}/${unit}"
        fi
    done

    echo "$CURRENT_VERSION" > "$VERSION_FILE"

    systemctl daemon-reload
    systemctl restart bsgate
    systemctl restart bsgame
    sleep 1

    if systemctl is-active --quiet bsgate && systemctl is-active --quiet bsgame; then
        die "update to v${TARGET_VERSION} did not come up cleanly — rolled back binaries AND unit files to v${CURRENT_VERSION}, and both services are running again. Investigate before retrying."
    fi
    die "update to v${TARGET_VERSION} did not come up cleanly, AND the rollback to v${CURRENT_VERSION} did not come up either. The box needs hands: check 'systemctl status bsgate bsgame' and 'journalctl -u bsgate -u bsgame'."
fi

for old in bsgate bsgame bsgate.service bsgame.service; do
    rm -f "${INSTALL_ROOT}/${old}.prev"
done

say "Updated v${CURRENT_VERSION} -> v${TARGET_VERSION}"
say "bsgate: $(systemctl is-active bsgate 2>/dev/null || echo unknown)   bsgame: $(systemctl is-active bsgame 2>/dev/null || echo unknown)"
